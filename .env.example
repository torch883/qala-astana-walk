# No secrets are required for the local mode. Do not commit .env.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SEC=3
DEMO_CACHE=0
# Weather: auto (Open-Meteo forecast for the city centre), off, or a demo scenario: frost, blizzard, rain, heat, mild.
WEATHER=auto
EMBEDDING_BACKEND=e5
# Optional, absolute path if model weights are stored outside the project:
# MODEL_CACHE_DIR=
